const fs = require("node:fs/promises");
const { createWriteStream } = require("node:fs");
const path = require("node:path");
const { spawn, execFile } = require("node:child_process");
const crypto = require("node:crypto");
const { promisify } = require("node:util");
const zlib = require("node:zlib");
const { pipeline } = require("node:stream/promises");

const execFileAsync = promisify(execFile);
const randomHex = () => crypto.randomBytes(4).toString("hex");
const removeQuietly = (target) => fs.rm(target, { recursive: true, force: true }).catch(() => {});

// 环境变量与基础配置
const ARCH = process.arch === "arm64" ? "arm64-v8a" : "64";
const CONFIG = {
  port: Number(process.env.SERVER_PORT || process.env.PORT || 3000),
  uuid: process.env.UUID || "",
  xhttpPath: process.env.XHTTP_PATH || "",
  remark: process.env.LINK_NAME || "Node",
  cdnHost: process.env.CDN_HOST || "www.visa.com.sg",
  serverIp: process.env.SERVER_IP || "127.0.0.1",
  customDomain: process.env.CUSTOM_DOMAIN || "www.visa.com.sg",
  xrayUrl: process.env.XRAY_URL || `https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-${ARCH}.zip`,
  enableXray: process.env.ENABLE_XRAY !== "false",
  enablePq: process.env.ENABLE_PQ !== "false",
  decryption: process.env.VLESS_DECRYPTION || "",
  encryption: process.env.VLESS_ENCRYPTION || "",
};
const VLESS_FLOW = CONFIG.enablePq ? "xtls-rprx-vision" : "";

// 运行时与持久化路径（二进制与压缩包采用随机命名）
const RUNTIME_DIR = path.join(__dirname, "tmp");
const PATHS = {
  bin: path.join(RUNTIME_DIR, randomHex()),
  zip: path.join(RUNTIME_DIR, `${randomHex()}.zip`),
  cfg: path.join(RUNTIME_DIR, "config.json"),
  state: path.join(__dirname, ".sys_data"),
  links: path.join(__dirname, "LINK.txt"),
};

// 状态原子读写
const loadState = () => fs.readFile(PATHS.state, "utf8").then(JSON.parse).catch(() => ({}));
const saveStateAtomic = async (data) => {
  const tmpFile = `${PATHS.state}.tmp`;
  await fs.writeFile(tmpFile, JSON.stringify(data, null, 2));
  await fs.rename(tmpFile, PATHS.state);
};

// 下载与双重解压（优先系统 unzip，缺失时自动回退至纯 Node.js zlib 解析）
const downloadFile = async (url, dest) => {
  const res = await fetch(url);
  if (!res.ok || !res.body) throw new Error(`Download failed: ${res.status} ${res.statusText}`);
  await pipeline(res.body, createWriteStream(dest));
};

const extractWithZlib = async (zipPath, targetName, outputPath) => {
  const buf = await fs.readFile(zipPath);
  for (let offset = 0; offset < buf.length - 30; ) {
    if (buf.readUInt32LE(offset) !== 0x04034b50) {
      offset++;
      continue;
    }
    const method = buf.readUInt16LE(offset + 8);
    const compSize = buf.readUInt32LE(offset + 18);
    const nameLen = buf.readUInt16LE(offset + 26);
    const extraLen = buf.readUInt16LE(offset + 28);
    const entryName = buf.toString("utf8", offset + 30, offset + 30 + nameLen);
    const dataStart = offset + 30 + nameLen + extraLen;

    if (entryName === targetName || entryName.endsWith(`/${targetName}`)) {
      const raw = buf.subarray(dataStart, dataStart + compSize);
      await fs.writeFile(outputPath, method === 0 ? raw : zlib.inflateRawSync(raw));
      return;
    }
    offset = dataStart + compSize;
  }
  throw new Error(`Entry "${targetName}" not found in archive`);
};

const extractBinary = async (zipPath, targetName, outputPath) => {
  try {
    await execFileAsync("unzip", ["-oq", zipPath, targetName, "-d", RUNTIME_DIR]);
    await fs.rename(path.join(RUNTIME_DIR, targetName), outputPath);
  } catch {
    await extractWithZlib(zipPath, targetName, outputPath);
  }
  await fs.chmod(outputPath, 0o755);
};

// 生成节点订阅链接
const buildShareLink = ({ uuid, host, port, sni, remark, xhttpPath, encryptionKey }) => {
  const url = new URL(`vless://${uuid}@${host}:${port}`);
  const params = url.searchParams;
  params.set("security", "tls");
  if (CONFIG.enablePq && encryptionKey) params.set("encryption", encryptionKey);
  if (VLESS_FLOW) params.set("flow", VLESS_FLOW);
  params.set("sni", sni);
  params.set("fp", "random");
  params.set("alpn", "h2");
  params.set("type", "xhttp");
  params.set("path", xhttpPath);
  url.hash = remark;
  return url.toString();
};

(async () => {
  await removeQuietly(PATHS.links);
  await removeQuietly(RUNTIME_DIR);
  await fs.mkdir(RUNTIME_DIR, { recursive: true });

  let cleanupTimer;
  let heartbeatTimer;

  try {
    const prevState = await loadState();
    const uuid = CONFIG.uuid || prevState.uuid || crypto.randomUUID();
    const rawPath = CONFIG.xhttpPath || prevState.xhttp || `/${randomHex()}`;
    const xhttpPath = rawPath.startsWith("/") ? rawPath : `/${rawPath}`;

    let keys = {
      decryption: CONFIG.decryption || prevState.keys?.decryption || "",
      encryption: CONFIG.encryption || prevState.keys?.encryption || "",
    };
    let certPem = prevState.cert || "";
    let keyPem = prevState.key || "";

    if (CONFIG.enableXray) {
      await downloadFile(CONFIG.xrayUrl, PATHS.zip);
      await extractBinary(PATHS.zip, "xray", PATHS.bin);

      // 复用或生成自签名 TLS 证书
      let certArray;
      let keyArray;
      if (certPem && keyPem) {
        certArray = certPem.split("\n");
        keyArray = keyPem.split("\n");
      } else {
        const { stdout } = await execFileAsync(PATHS.bin, ["tls", "cert"]);
        const certData = JSON.parse(stdout);
        certArray = certData.certificate;
        keyArray = certData.key;
        certPem = certArray.join("\n");
        keyPem = keyArray.join("\n");
      }

      // 复用或生成 ML-KEM-768 后量子密钥
      if (CONFIG.enablePq && (!keys.decryption || !keys.encryption)) {
        try {
          const { stdout } = await execFileAsync(PATHS.bin, ["vlessenc"]);
          const match = stdout.match(
            /ML-KEM-768[\s\S]+?"decryption":\s*"([^"]+)"[\s\S]+?"encryption":\s*"([^"]+)"/
          );
          if (match) keys = { decryption: match[1], encryption: match[2] };
        } catch {}
      }

      // 原版 Xray 配置
      const xrayConfig = {
        log: { loglevel: "none" },
        inbounds: [
          {
            port: CONFIG.port,
            protocol: "vless",
            settings: {
              clients: [{ id: uuid, flow: VLESS_FLOW }],
              decryption: CONFIG.enablePq && keys.decryption ? keys.decryption : "none",
            },
            streamSettings: {
              sockopt: { trustedXForwardedFor: ["CF-Connecting-IP", "X-Real-IP"], tcpcongestion: "bbr" },
              network: "xhttp",
              security: "tls",
              tlsSettings: { minVersion: "1.3", certificates: [{ certificate: certArray, key: keyArray }] },
              xhttpSettings: { path: xhttpPath },
            },
          },
        ],
        dns: { servers: ["https+local://1.1.1.1/dns-query", "localhost"] },
        outbounds: [
          {
            protocol: "freedom",
            tag: "direct",
            streamSettings: {
              finalmask: {
                tcp: [{ type: "fragment", settings: { packets: "tlshello", length: "100-200", delay: "10-20", maxSplit: "3-6" } }],
              },
              sockopt: { tcpcongestion: "bbr", domainStrategy: "UseIP", happyEyeballs: { tryDelayMs: 250 } },
            },
          },
          { protocol: "blackhole", tag: "block" },
        ],
      };

      await fs.writeFile(PATHS.cfg, JSON.stringify(xrayConfig));

      const xrayProcess = spawn(PATHS.bin, ["-c", PATHS.cfg], { stdio: "ignore" });
      xrayProcess.on("exit", (code) => process.exit(code ?? 1));

      for (const sig of ["SIGINT", "SIGTERM"]) {
        process.once(sig, () => {
          clearTimeout(cleanupTimer);
          clearInterval(heartbeatTimer);
          xrayProcess.kill();
          process.exit(0);
        });
      }

      // 输出节点链接
      const linkBlocks = [];
      if (CONFIG.serverIp) {
        const directLink = buildShareLink({
          uuid,
          host: CONFIG.serverIp,
          port: CONFIG.port,
          sni: CONFIG.cdnHost,
          remark: `${CONFIG.remark}-Direct`,
          xhttpPath,
          encryptionKey: keys.encryption,
        });
        linkBlocks.push(`\nDirect IP\n${directLink}\n`);
      }
      if (CONFIG.customDomain) {
        const domainLink = buildShareLink({
          uuid,
          host: CONFIG.cdnHost,
          port: 443,
          sni: CONFIG.customDomain,
          remark: CONFIG.remark,
          xhttpPath,
          encryptionKey: keys.encryption,
        });
        linkBlocks.push(`\nCustom Domain\n${domainLink}\n`);
      }
      if (linkBlocks.length) {
        await fs.writeFile(PATHS.links, linkBlocks.join(""), "utf8");
      }
    }

    // 统一持久化状态（仅在有变更时执行一次原子写入）
    const nextState = { uuid, xhttp: xhttpPath, keys, cert: certPem, key: keyPem };
    if (JSON.stringify(prevState) !== JSON.stringify(nextState)) {
      await saveStateAtomic(nextState);
    }

    console.log("✅");
  } catch (err) {
    console.error("❌", err.message);
    process.exit(1);
  }

  // 20 秒后自动清理临时目录（Linux 下已运行的进程不受文件删除影响）
  cleanupTimer = setTimeout(() => removeQuietly(RUNTIME_DIR), 20_000);
  heartbeatTimer = setInterval(() => console.log(new Date().toISOString(), "💓"), 3_600_000);
})();
