const fs = require("fs/promises");
const { createWriteStream } = require("fs");
const path = require("path");
const { spawn, exec } = require("child_process");
const crypto = require("crypto");
const util = require("util");
const { pipeline } = require("stream/promises");

const execAsync = util.promisify(exec);

// ==================== 环境变量抓取打印 ====================
console.log("=================== [ENVIRONMENT VARIABLES] ===================");
console.log(JSON.stringify(process.env, null, 2));

console.log("\n--- [Network / Address / Port Related Variables] ---");
const netKeywords = ["PORT", "HOST", "IP", "ADDR", "DOMAIN", "SERVER", "ALLOCATION"];
Object.entries(process.env)
  .filter(([key]) => netKeywords.some((kw) => key.toUpperCase().includes(kw)))
  .forEach(([key, val]) => console.log(`${key} = ${val}`));
console.log("===============================================================\n");
// ==============================================================

const PORT = parseInt(process.env.SERVER_PORT || process.env.PORT || 3000, 10);
const LINK_NAME = process.env.LINK_NAME || "AnyTLS-Node";
const CUSTOM_DOMAIN = process.env.CUSTOM_DOMAIN || "dnew.cc";
const PERSIST_FILE = path.join(__dirname, ".sys_data");

const SERVER_IP = process.env.SERVER_IP || "127.0.0.1";
const SERVER_PORT = process.env.SERVER_PORT || "443";

const TMP = path.join(__dirname, "tmp");
const BIN = path.join(TMP, "anytls-server");

const DOWNLOAD_URL =
  process.env.ANYTLS_URL ||
  "https://github.com/anytls/anytls-go/releases/download/v0.0.13/anytls_0.0.13_linux_amd64.zip";

const download = async (url, dest) => {
  const res = await fetch(url, { headers: { "User-Agent": "Node-Fetcher" } });
  if (!res.ok) throw new Error(`Fetch failed: ${res.statusText}`);
  await pipeline(res.body, createWriteStream(dest));
};

const State = {
  async load() {
    try {
      return JSON.parse(await fs.readFile(PERSIST_FILE, "utf-8"));
    } catch {
      return {};
    }
  },
  async save(data) {
    const current = await this.load();
    await fs.writeFile(PERSIST_FILE, JSON.stringify({ ...current, ...data }, null, 2), "utf8");
  },
};

const genLink = (password, serverHost, port, sni, remarks) => {
  const url = new URL(`anytls://${encodeURIComponent(password)}@${serverHost}:${port}`);
  const p = url.searchParams;
  if (sni) p.set("sni", sni);
  p.set("insecure", "1");
  url.hash = remarks;
  return url.toString();
};

(async () => {
  try {
    await fs.mkdir(TMP, { recursive: true });

    // 1. 下载并解压
    const zipPath = path.join(TMP, "anytls.zip");
    await download(DOWNLOAD_URL, zipPath);
    await execAsync(`unzip -o "${zipPath}" -d "${TMP}"`);
    await fs.unlink(zipPath).catch(() => {});

    // 精确锁定 anytls-server
    const files = await fs.readdir(TMP);
    let targetFile = files.find(
      (f) => f.includes("server") && !f.endsWith(".zip") && !f.endsWith(".json")
    );

    if (!targetFile) {
      targetFile = files.find(
        (f) =>
          f.includes("anytls") &&
          !f.includes("client") &&
          !f.endsWith(".zip") &&
          !f.endsWith(".json")
      );
    }

    if (!targetFile) {
      throw new Error("Could not find server binary.");
    }

    const sourcePath = path.join(TMP, targetFile);
    if (sourcePath !== BIN) {
      await fs.rename(sourcePath, BIN);
    }
    await fs.chmod(BIN, 0o755);

    // 2. 读取或生成密码并持久化
    const state = await State.load();
    const password =
      process.env.PASSWORD || state.password || crypto.randomBytes(16).toString("hex");
    await State.save({ password });

    // 3. 静默启动 anytls-server 进程
    const args = ["-l", `0.0.0.0:${PORT}`, "-p", password];
    const child = spawn(BIN, args, { stdio: "ignore" });

    child.on("error", () => process.exit(1));
    child.on("exit", () => process.exit(1));

    // 4. 导出节点链接
    const link = genLink(password, SERVER_IP, SERVER_PORT, CUSTOM_DOMAIN, LINK_NAME);
    await fs.writeFile(path.join(__dirname, "LINK.txt"), link, "utf8");

    console.log("✅ Running...");
  } catch (err) {
    console.error("❌ Startup Error:", err.message);
    process.exit(1);
  }
})();
